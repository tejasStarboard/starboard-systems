{
  "name": "starboard-systems",
  "version": "0.0.1",
  "description": "Starboard Systems monorepo \u2014 shell BFF, domain services, and extensions",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/tejasStarboard/starboard-systems.git"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --concurrency=25",
    "lint": "turbo lint",
    "format": "turbo format",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,css}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "ci:affected": "turbo run lint typecheck test build --filter=...[origin/dev]"
  },
  "devDependencies": {
    "@starboard/tool-eslint-config": "workspace:*",
    "@starboard/tool-typescript-config": "workspace:*",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
