{
  "name": "@starboard/ext-quoting-pdf",
  "version": "0.0.1",
  "description": "Driving built-in extension `quoting.pdf` — react-pdf quote PDF preview + export, defines quoting.pdf.templates",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/tejasStarboard/starboard-systems.git",
    "directory": "extensions/builtins/quoting-pdf"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./manifest": {
      "types": "./src/manifest.ts",
      "default": "./src/manifest.ts"
    },
    "./view": {
      "types": "./src/lib/build-document-view.ts",
      "default": "./src/lib/build-document-view.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./templates": {
      "types": "./src/templates/index.ts",
      "default": "./src/templates/index.ts"
    },
    "./test-fixtures": {
      "types": "./src/lib/test-fixtures.ts",
      "default": "./src/lib/test-fixtures.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@starboard/tool-typescript-config": "workspace:*",
    "@types/bun": "^1.3.5",
    "@types/react": "^19",
    "react": "19.3.1",
    "typescript": "^5.9.3",
    "@playwright/test": "^1.64.1",
    "@starboard/tool-e2e": "workspace:*"
  },
  "peerDependencies": {
    "react": "19.3.1"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@react-pdf/renderer": "^4.9.0",
    "@starboard/ext-quoting-document": "workspace:*",
    "@starboard/lib-contracts": "workspace:*",
    "@starboard/lib-pricing": "workspace:*",
    "@starboard/lib-ui": "workspace:*"
  }
}
