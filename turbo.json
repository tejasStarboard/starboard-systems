{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "concurrency": "25",
  "globalPassThroughEnv": [
    "CI",
    "POSTGRES_URL",
    "REDIS_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_DOMAIN",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "RESEND_API_KEY",
    "EMAIL_SENDER_NAME",
    "EMAIL_SENDER_ADDRESS",
    "APP_URL",
    "NEXT_PUBLIC_APP_URL",
    "QUOTES_SERVICE_URL",
    "GEOGRAPHY_SERVICE_URL",
    "CRM_SERVICE_URL",
    "RATES_SERVICE_URL",
    "INGESTION_SERVICE_URL",
    "INGESTION_SERVICE_PORT",
    "MESSAGING_SERVICE_URL",
    "MESSAGING_SERVICE_PORT",
    "MESSAGING_TOKEN_KEY",
    "MESSAGING_DATA_DIR",
    "SPOT_SERVICE_URL",
    "SPOT_SERVICE_PORT",
    "TEMPORAL_ADDRESS",
    "TEMPORAL_NAMESPACE",
    "TEMPORAL_TASK_QUEUE",
    "INTERNAL_SERVICE_TOKEN",
    "SKIP_ENV_VALIDATION",
    "VERCEL_URL",
    "VERCEL_PROJECT_PRODUCTION_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
