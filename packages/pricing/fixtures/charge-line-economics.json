{
  "$schema_version": "1.0.0",
  "description": "Charge-line economics (072 + 085). Multi-CT FCL with equipmentAmounts prices each CT like starboard-2 deriveFclRateTotals: one container, apply that CT's dial (or lane dial fallback), then × count. A finite sellAmount replaces that row's sell; markup includes the uplift so sell = buy + markup. isVisible false (Split off / absorbed) still contributes. Include and scope_override follow the existing inclusion predicate.",
  "cases": [
    {
      "id": "single-ct-percent-markup",
      "input": {
        "lines": [
          {
            "amount": 1000,
            "baseMode": "per_eq",
            "surcharges": []
          }
        ],
        "markupType": "percent",
        "markupValue": 10,
        "usage": { "container": 1 }
      },
      "expected": { "buy": 1000, "markup": 100, "sell": 1100 }
    },
    {
      "id": "multi-ct-flat-markup",
      "input": {
        "lines": [
          {
            "amount": 0,
            "baseMode": "per_eq",
            "equipmentAmounts": [
              { "containerType": "20GP", "amount": 800, "count": 2 },
              { "containerType": "40HC", "amount": 1200, "count": 1 }
            ]
          }
        ],
        "markupType": "amount",
        "markupValue": 150,
        "usage": { "container": 3 }
      },
      "expected": { "buy": 2800, "markup": 450, "sell": 3250 }
    },
    {
      "id": "multi-ct-distinct-dials",
      "input": {
        "lines": [
          {
            "amount": 0,
            "baseMode": "per_eq",
            "equipmentAmounts": [
              {
                "containerType": "20GP",
                "amount": 800,
                "count": 2,
                "markupType": "amount",
                "markupValue": 100
              },
              {
                "containerType": "40HC",
                "amount": 1200,
                "count": 1,
                "markupType": "percent",
                "markupValue": 10
              }
            ]
          }
        ],
        "markupType": "amount",
        "markupValue": 0,
        "usage": { "container": 3 }
      },
      "expected": { "buy": 2800, "markup": 320, "sell": 3120 }
    },
    {
      "id": "equipment-type-scopes-surcharge",
      "input": {
        "lines": [
          {
            "amount": 0,
            "baseMode": "per_eq",
            "equipmentAmounts": [
              { "containerType": "20GP", "amount": 1000, "count": 1 },
              { "containerType": "40HC", "amount": 1000, "count": 1 }
            ],
            "surcharges": [
              {
                "usageUnit": "flat",
                "rate": 50,
                "source": "manual",
                "isIncludedInTotal": true,
                "leg": "freight",
                "equipmentType": "20GP"
              }
            ]
          }
        ],
        "markupType": "amount",
        "markupValue": 0,
        "usage": { "container": 2 }
      },
      "expected": { "buy": 2050, "markup": 0, "sell": 2050 }
    },
    {
      "id": "row-fx-converts-into-quote-currency",
      "input": {
        "lines": [
          {
            "amount": 1000,
            "baseMode": "flat",
            "surcharges": [
              {
                "usageUnit": "flat",
                "rate": 100,
                "currencyCode": "EUR",
                "source": "manual",
                "isIncludedInTotal": true,
                "leg": "freight"
              }
            ]
          }
        ],
        "markupType": "amount",
        "markupValue": 0,
        "quoteCurrency": "USD",
        "fxRates": { "EUR": { "USD": 1.1 } }
      },
      "expected": { "buy": 1110, "markup": 0, "sell": 1110 }
    },
    {
      "id": "sell-amount-uplift-is-markup",
      "input": {
        "lines": [
          {
            "amount": 1000,
            "baseMode": "flat",
            "surcharges": [
              {
                "usageUnit": "flat",
                "rate": 100,
                "sellAmount": 180,
                "source": "manual",
                "isIncludedInTotal": true,
                "isVisible": true,
                "leg": "freight"
              }
            ]
          }
        ],
        "markupType": "amount",
        "markupValue": 0
      },
      "expected": { "buy": 1100, "markup": 80, "sell": 1180 }
    },
    {
      "id": "sell-amount-plus-percent-dial",
      "input": {
        "lines": [
          {
            "amount": 1000,
            "baseMode": "flat",
            "surcharges": [
              {
                "usageUnit": "flat",
                "rate": 100,
                "sellAmount": 180,
                "source": "manual",
                "isIncludedInTotal": true,
                "leg": "freight"
              }
            ]
          }
        ],
        "markupType": "percent",
        "markupValue": 10
      },
      "expected": { "buy": 1100, "markup": 190, "sell": 1290 }
    },
    {
      "id": "split-off-still-in-total",
      "input": {
        "lines": [
          {
            "amount": 1000,
            "surcharges": [
              {
                "usageUnit": "flat",
                "rate": 50,
                "source": "carrier",
                "isIncludedInTotal": true,
                "isVisible": false,
                "leg": "origin"
              }
            ]
          }
        ],
        "markupType": "amount",
        "markupValue": 0
      },
      "expected": { "buy": 1050, "markup": 0, "sell": 1050 }
    },
    {
      "id": "include-off-drops-sell-override",
      "input": {
        "lines": [
          {
            "amount": 1000,
            "surcharges": [
              {
                "usageUnit": "flat",
                "rate": 50,
                "sellAmount": 999,
                "source": "manual",
                "isIncludedInTotal": false,
                "isVisible": true,
                "leg": "freight"
              }
            ]
          }
        ],
        "markupType": "amount",
        "markupValue": 0
      },
      "expected": { "buy": 1000, "markup": 0, "sell": 1000 }
    },
    {
      "id": "free-usage-reduces-container-buy",
      "input": {
        "lines": [
          {
            "amount": 500,
            "surcharges": [
              {
                "usageUnit": "container",
                "rate": 10,
                "freeUsage": 2,
                "source": "carrier",
                "isIncludedInTotal": true,
                "leg": "freight"
              }
            ]
          }
        ],
        "markupType": "amount",
        "markupValue": 0,
        "usage": { "container": 5 }
      },
      "expected": { "buy": 530, "markup": 0, "sell": 530 }
    }
  ]
}
