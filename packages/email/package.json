    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "^6.35.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@workspace/typescript-config": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
