{
  "name": "@starboard/lib-db",
  "version": "0.0.1",
  "description": "Drizzle schemas and DB client (Neon / node-postgres)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/tejasStarboard/starboard-systems.git",
    "directory": "packages/database"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "bun": "./src/schema/index.ts",
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    },
    "./schema/auth": {
      "types": "./src/schema/auth.ts",
      "bun": "./src/schema/auth.ts",
      "import": "./dist/schema/auth.js",
      "default": "./dist/schema/auth.js"
    },
    "./schema/quote": {
      "types": "./src/schema/quote.ts",
      "bun": "./src/schema/quote.ts",
      "import": "./dist/schema/quote.js",
      "default": "./dist/schema/quote.js"
    },
    "./schema/geography": {
      "types": "./src/schema/geography.ts",
      "bun": "./src/schema/geography.ts",
      "import": "./dist/schema/geography.js",
      "default": "./dist/schema/geography.js"
    },
    "./schema/rates": {
      "types": "./src/schema/rates.ts",
      "bun": "./src/schema/rates.ts",
      "import": "./dist/schema/rates.js",
      "default": "./dist/schema/rates.js"
    },
    "./schema/platform": {
      "types": "./src/schema/platform.ts",
      "bun": "./src/schema/platform.ts",
      "import": "./dist/schema/platform.js",
      "default": "./dist/schema/platform.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push --force",
    "db:push:ci": "tsx scripts/push-schema-ci.ts",
    "db:push:interactive": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@starboard/lib-contracts": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@starboard/tool-typescript-config": "workspace:*",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
